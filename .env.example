# netsa 部署参数模板：复制为 .env 后按需修改，所有变量均为可选
# 外部大模型的地址、名称与密钥在页面「自学习 → 外部模型」中配置
# 检测相关的开关（对外发布服务清单 exposure、威胁情报 intel、内网网段 geo.intranet、原始日志留存 rawlog、检测阈值等）
# 不在这里，在 configs/docker.yaml 中修改，改完执行 docker compose restart netsa 生效

# netsa 镜像，生产环境建议固定版本便于回滚；告警归档数据库镜像
# 容器内存上限（默认 4g）；NETSA_GOMEMLIMIT 请设为它的 85% 左右
# NETSA_MEM_LIMIT=4g
# NETSA_GOMEMLIMIT=3400MiB

# NETSA_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/netsa:1.14.0
# PG_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/pgvector:pg18

# 宿主机端口，被占用时修改
# NETSA_HTTP_PORT=8080
# NETSA_SYSLOG_PORT=5514

# 管理员 admin 的初始密码，只在首次启动时生效；不设置则随机生成并输出到日志
# NETSA_ADMIN_PASSWORD=

# 告警归档，配合 docker compose --profile archive up -d 使用
# 两处密码须相同；含 @ : / ? # 等字符时，连接串中需 URL 编码（如 @ 写成 %40）
# POSTGRES_PASSWORD=
# NETSA_ARCHIVE_DSN=postgres://netsa:<密码>@postgres:5432/netsa?sslmode=disable

# 周报 / 月报的发信口令
# NETSA_SMTP_PASSWORD=
