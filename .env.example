# netsa 部署参数模板：复制为同目录的 .env 后按需修改（.env 不会提交到仓库）
#   cp .env.example .env
# 未设置的变量使用 docker-compose.yml 中的默认值。

# ---------- 镜像 ----------
# netsa 镜像，默认 latest；生产环境建议固定版本，便于回滚
# NETSA_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/netsa:1.6.9
# 告警归档数据库镜像（PostgreSQL 18 + pgvector）
# PG_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/pgvector:pg18

# ---------- 登录 ----------
# 首次启动时管理员 admin 的初始密码；不设置则随机生成并输出在日志中（首次登录后须修改）
# NETSA_ADMIN_PASSWORD=

# ---------- 告警归档（可选，需 docker compose --profile archive up -d） ----------
# 两处密码必须相同，请使用强密码；密码含 @ : / ? # 等字符时，连接串中需按 URL 编码（如 @ 写成 %40）
# POSTGRES_PASSWORD=
# NETSA_ARCHIVE_DSN=postgres://netsa:<密码>@postgres:5432/netsa?sslmode=disable

# ---------- 其他可选密钥 ----------
# 外部大模型密钥（configs/docker.yaml 中启用 ai.enabled 后使用）
# NETSA_AI_API_KEY=
# 周报 / 月报发信服务器口令（configs/docker.yaml 中的 report.smtp）
# NETSA_SMTP_PASSWORD=
